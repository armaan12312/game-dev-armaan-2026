<html xmlns:v="urn:schemas-microsoft-com:vml">

<head>
<title>Moving Objects</title>

<style>
 v\:* {BEHAVIOR: url(#default#VML)}
</style>

<script>

document.name = "myDocument"
window.name = "myWindow"
document.cookie = "cookieName=fred"

var splitIndex = 0;
var splitArray = new Array();

function splits(string,text) {
    var strLength = string.length, txtLength = text.length;
    if ((strLength == 0) || (txtLength == 0)) return;

    var i = string.indexOf(text);
    if ((!i) && (text != string.substring(0,txtLength))) return;
    if (i == -1) {
        splitArray[splitIndex++] = string;
        return;
    }

    splitArray[splitIndex++] = string.substring(0,i);

    if (i+txtLength < strLength)
        splits(string.substring(i+txtLength,strLength),text);

    return;
}

function split(string,text) {
    splitIndex = 0;
    splits(string,text);
}

function join(arrayName) {
    var temp = '';
    for (var i=0; i<splitIndex; i++)
        temp += arrayName[i] + '\n';
    if (escape(temp.substring(0,1)) == '%0A')
        return temp.substring(1,temp.length);
    else
        return temp;
}

function sort(arrayName) {
    for (var i=0; i<(splitIndex-1); i++)
        for (var j=i+1; j<splitIndex; j++)
            if (arrayName[j] < arrayName[i]) {
                var dummy = arrayName[i];
                arrayName[i] = arrayName[j];
                arrayName[j] = dummy;
            }
}

function sorttext() {
    split(document.myForm.myTextarea.value,'\n');
    sort(splitArray);
    document.myForm.myTextarea.value = join(splitArray);
}

function myObjectData(myObject){

 window.status = 'Please Wait'

 document.myForm.myText1.value = ''
 document.myForm.myTextarea.value = ''

 if (myObject == null){
    document.myForm.myTextarea.value = 'This object is not available in your browser.'
    return
 }

 myLoop = 0

 for (var prop in myObject){
    myLoop+=1
    document.myForm.myTextarea.value+=myObject.name+'.'+prop+'='+myObject[prop]+ '\n'

    if (myLoop % 3 == 1){
       window.status += '.'
    }
 }

 document.myForm.myText1.value = myObject.name || 'Browser Object'

 window.status += 'Loaded'

 sorttext()

 window.status += 'Sorted.'
}

document.counter = 0

function moreAnimations(){
  document.counter+=1

  let myPic = document.getElementById('move1')

  myPic.style.left = (parseInt(myPic.style.left) + 2) + 'px'
  myPic.style.top = (parseInt(myPic.style.top) + 1) + 'px'

  if ((document.counter>10) && (document.counter<20)){
      myPic.style.height=parseInt(myPic.style.height)+2
  }
}

function myClear(){
   document.myForm.myText1.value = ''
   document.myForm.myTextarea.value = ''
   document.myForm2.myTextarea.value = ''
   alert('Everything has been cleared!')
}

function myShowInfo(){
   document.myForm.myTextarea.value =
   'Browser: ' + navigator.appName +
   '\nVersion: ' + navigator.appVersion +
   '\nLanguage: ' + navigator.language +
   '\nPlatform: ' + navigator.platform +
   '\nCookies Enabled: ' + navigator.cookieEnabled
}

function myShowScreen(){
   document.myForm.myTextarea.value =
   'Screen Width: ' + screen.width +
   '\nScreen Height: ' + screen.height +
   '\nAvailable Width: ' + screen.availWidth +
   '\nAvailable Height: ' + screen.availHeight
}

function myShowTime(){
   document.myForm.myTextarea.value =
   'Current Date and Time: ' + new Date()
}

</script>
</head>

<body>

